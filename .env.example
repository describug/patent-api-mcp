# 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올리지 않는다.
KIPRIS_SERVICE_KEY=
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
KIPRIS_MONTHLY_LIMIT=1000
KIPRIS_WARN_AT=900

# KIPRIS Plus에서 신청한 상품(쉼표로). 켠 상품의 도구만 등록된다. publication(공개·등록공보)은 항상 켜진다.
#   publication(특허·실용 공개·등록공보) opinion(의견제출통지서) rejection(거절결정서) allowance(등록결정서)
#   deadline(통지서 마감기한) claim_history(청구항 변동 이력) registration(등록사항)
#   citation(인용문헌) citing(피인용문헌) legal_status(법적 상태 이력 ST.27) family(특허 패밀리) | all
PATENT_API_KIPRIS_PRODUCTS=publication
# 개별로 끄고 켤 수도 있다(목록보다 우선): KIPRIS_PRODUCT_FAMILY=false

# 선택: 캐시 보존 기간(일)
# CACHE_TTL_BIBLIO_DAYS=30
# CACHE_TTL_TEXT_DAYS=30
# CACHE_TTL_FAMILY_DAYS=7
# CACHE_TTL_LEGAL_DAYS=1
# CACHE_TTL_SEARCH_DAYS=1
# CACHE_TTL_DOCS_DAYS=1        # 심사 서류·마감기한·청구항 이력·등록사항·법적 상태

# 선택: 기타
# PATENT_API_MAX_TEXT_CHARS=20000
# PATENT_API_HTTP_TIMEOUT=20
# PATENT_API_CACHE_PATH=
# KIPRIS_BASE_URL=https://plus.kipris.or.kr/kipo-api/kipi/patUtiModInfoSearchSevice
# KIPRIS_REST_BASE_URL=https://plus.kipris.or.kr/openapi/rest

# ── 원격 서버(HTTP) 모드 전용 — 로컬 stdio에서는 필요 없다. 자세히: docs/원격_배포.md
# PATENT_API_TRANSPORT=http
# PATENT_API_PUBLIC_URL=https://patent-api-xxxx.a.run.app
# PATENT_API_ALLOWED_DOMAINS=example.com          # 비어 있으면(이메일도) HTTP 모드가 시작하지 않는다
# PATENT_API_ALLOWED_EMAILS=me@gmail.com
# PATENT_API_AUTH_SECRET=                          # openssl rand -base64 48
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# PATENT_API_OAUTH_CLIENT_ID=gemini-enterprise     # Gemini Enterprise처럼 OAuth 값을 손으로 넣는 경우만
# PATENT_API_HOST=127.0.0.1
# PORT=8080
